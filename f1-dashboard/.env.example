# All variables are optional. Without them the app works with historical
# data and shows the latest completed session instead of live timing.

# Option A: an OpenF1 access token you already have (sent as a Bearer token).
OPENF1_API_KEY=

# Option B: your OpenF1 account login. The server exchanges these for a
# 1-hour token at https://api.openf1.org/token and refreshes it automatically.
OPENF1_USERNAME=
OPENF1_PASSWORD=

# Advanced: point the API clients somewhere else (e.g. a local mock server).
# Leave unset in normal use.
# OPENF1_BASE_URL=https://api.openf1.org
# JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1
