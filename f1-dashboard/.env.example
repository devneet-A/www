# F1 Live Dashboard: environment variables.
#
# Local:  copy this file to .env.local (git-ignored) and fill in what you have.
# Vercel: add the same names under Project -> Settings -> Environment Variables,
#         then redeploy (variables only apply to new deployments).
#
# Everything is optional. Without OpenF1 credentials the app uses free
# historical data and shows the latest completed session instead of live timing.
# Server-side only: none of these is ever sent to the browser.

# --- OpenF1 live data: use ONE of the two options ----------------------------

# Option A: an OpenF1 access token you already have (sent as a Bearer token).
OPENF1_API_KEY=

# Option B: your OpenF1 account login. The server exchanges these for a
# 1-hour token at https://api.openf1.org/token and renews it automatically.
OPENF1_USERNAME=
OPENF1_PASSWORD=

# --- Advanced ------------------------------------------------------------------
# Point the API clients somewhere else. Leave unset in normal use.
# (`npm run mock` sets these itself to use the local mock in scripts/mock/.)
# OPENF1_BASE_URL=https://api.openf1.org
# JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1
